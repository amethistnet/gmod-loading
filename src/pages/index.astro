---
import LoadingMock from "../components/LoadingMock.astro";
import "../styles/loading-page.scss";
---

<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width"/>
    <meta name="generator" content={Astro.generator}/>
    <title>Garry's Mod Loading</title>
</head>
<body>
<div class="loading-background" aria-hidden="true">
    <img class="loading-background__image" data-background-slideshow alt=""/>
</div>
<div class="container">
    <div class="centerContainer">
        <p class="serverName" data-server-name></p>
        <div class="card">
            <p class="text" data-server-gamemode/>
            <div class="cardRow">
                <img class="cardImg" data-steam-avatar src="https://unavatar.io/steam/profile:" alt=""/>
                <div class="walk" data-walk-face>:v</div>
                <img class="cardImg" data-gmod="mapImage" alt=""/>
            </div>
            <div class="text">
                <p>YOU ARE HEADING TO</p>
                <p data-map-name/>
            </div>
        </div>
    </div>
</div>

<script>
    import {initializeLoadingPage} from "../loading-page";

    initializeLoadingPage();
</script>

<LoadingMock/>
</body>
</html>
