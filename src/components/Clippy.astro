<script>
    import { gmodReady } from "../gmod-client";

    const messageInterval = 3000;
    const balloonText = document.querySelector<HTMLElement>("[data-balloon-text]");

    if (balloonText) {
        gmodReady.then((gmod) => {
            const messages: string[] = [
                `${gmod.mapname}???`,
                "Use 'playermodel_selector' in console to change playermodel and hands!"
            ];

            switch (gmod.gamemode) {
                case "sandbox":
                    messages.push("hold C and select your playermodel and hands!");
                    messages.push("the event hasn't started yet...");
                    break;
                case "terrortown":
                    messages.push("a lot more roles this time so be careful");
                    messages.push("find a brick and throw it at someone");
                    messages.push("morbus weapons are here somehow i can't get rid of them");
                    break;
                case "morbusreborn":
                    messages.push("if you are the brood alien press C to open the upgrade menu");
                    messages.push("cyborgs don't have needs so use that to your advantage and hunt the aliens");
                    messages.push("custom playermodels aren't around for this one so communication is key");
                    break;
                case "dropzone":
                    messages.push("remember to press F1 to select spells and abilities (this only works in pre-round or while dead)");
                    messages.push("double tap a movement key to dash");
                    messages.push("airstrafing becomes less effective the higher % you are");
                    messages.push("press E to raise a shield");
                    messages.push("ultimates can only be cast on your last life");
                    break;
                case "homicide":
                    messages.push("it's like murder, but better(?)");
                    break;
                case "prop_hunt":
                    messages.push("let's see who spams taunts the most");
                    break;
                case "pvb":
                    messages.push("this gamemode sucks");
                    break;
            }

            let index = Math.floor(Math.random() * messages.length);
            balloonText.textContent = messages[index];

            window.setInterval(() => {
                if (messages.length > 1) {
                    const offset = Math.floor(Math.random() * (messages.length - 1)) + 1;
                    index = (index + offset) % messages.length;
                }

                balloonText.textContent = messages[index];
            }, messageInterval);
        });
    }
</script>

<div class="clippy">
    <div class="clippy-image">
        <img src="/img/adachireinerdcroppedcompressed.jpg" alt=""/>
        <div class="clippy-balloon">
            <div class="clippy-tip"/>
            <div data-balloon-text class="clippy-text">Loading server details...</div>
        </div>
    </div>
</div>



<style>
    @font-face {
        font-family: "Microsoft Sans";
        src: url("/font/microsoft_sans.ttf") format("truetype");
        font-style: normal;
        font-weight: 400;
        font-display: swap;
    }

    .clippy {
        position: absolute;
        top: 0;
        left: 0;
        padding: 1rem;
    }

    .clippy-image {
        position: relative;
    }

    .clippy-image img {
        display: block;
    }

    .clippy-balloon {
        --tip-offset-x: 25px;
        --tip-width: 10px;
        --tip-height: 16px;

        position: absolute;
        top: calc(60% + var(--tip-height));
        left: calc(50% - var(--tip-offset-x));
        z-index: 67;
        background: #FFC;
        color: black;
        padding: 8px;
        border: 1px solid black;
        border-radius: 5px;
    }

    .clippy-text {
        max-width: 240px;
        min-width: 160px;
        font-family: "Microsoft Sans", sans-serif;
        font-size: 11pt;
        word-break: break-word;
    }

    .clippy-tip {
        width: var(--tip-width);
        height: var(--tip-height);
        background: url(data:image/png;base64,) no-repeat;
        background-size: 20px 32px;
        image-rendering: pixelated;
        position: absolute;
    }

    .clippy-balloon .clippy-tip {
        top: 0;
        left: var(--tip-offset-x);
        transform: translateY(-100%);
        background-position: -10px -16px;
    }
</style>
